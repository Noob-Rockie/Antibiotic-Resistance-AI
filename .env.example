# ---------------------------------------------------------------------------
# Antibiotic-Resistance-AI - environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Drug information / labelling -------------------------------------------
# openFDA drug label API. Key optional (raises rate limit 240/min -> 120k/day).
# Docs: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# RxNorm / RxNav (NLM). No key required. Base URL kept configurable.
# Docs: https://lhncbc.nlm.nih.gov/RxNav/APIs/
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST

# --- Medicine price ----------------------------------------------------------
# NADAC (US CMS national average drug acquisition cost) via data.medicaid.gov.
# Public Socrata-style endpoint, no key required.
# Docs: https://data.medicaid.gov/dataset/
NADAC_DATASET_URL=https://download.medicaid.gov/data/nadac-national-average-drug-acquisition-cost.csv

# Set to 0 to run the app fully offline (all live lookups disabled).
ENABLE_LIVE_API=1

# Cache TTL for API responses, in hours.
API_CACHE_TTL_HOURS=24

# --- Web backend (11_APPLICATION/web/backend.py) ----------------------------
# MongoDB connection string. Leave unset for local dev (falls back to
# in-memory storage + a local CSV for clinician reviews). On Railway, this is
# provided automatically once a MongoDB database is added to the project
# (as MONGO_URL / MONGO_PUBLIC_URL) — no need to set MONGODB_URI by hand there.
MONGODB_URI=

# Comma-separated list of allowed frontend origins for CORS, e.g. your
# Netlify site URL. Defaults to "*" (fine while testing; tighten before
# sharing the link).
CORS_ORIGINS=*
